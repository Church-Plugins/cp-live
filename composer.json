{
  "name": "churchplugins/cp-live",
  "type": "wordpress-plugin",
  "description": "Church live plugin.",
  "keywords": [],
  "homepage": "https://churchplugins.com",
  "authors": [
    {
      "name": "Tanner Moushey",
      "email": "tanner@churchplugins.com",
      "homepage": "https://churchplugins.com"
    }
  ],
  "require": {
    "php": ">=7.0.0",
    "composer/installers": "*",
    "wpackio/enqueue": "^3.4"
  },
  "autoload": {
    "psr-4": {
      "CP_Live\\": "includes/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "scripts": {
    "lint": [
      "php -l includes/Admin/Request_Actions.php",
      "php -l includes/Services/_Init.php",
      "php -l includes/Integrations/CP_Locations.php",
      "php -l tests/request-actions.php"
    ],
    "test": "php tests/request-actions.php"
  }
}
